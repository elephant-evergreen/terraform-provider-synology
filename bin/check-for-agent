#!/bin/sh
set -eu
export GOCACHE="${GOCACHE:-$PWD/work/.cache/go-build}"
export GOMAXPROCS="${GOMAXPROCS:-2}"
export TF_ACC_TERRAFORM_PATH="$(command -v terraform)"
export TF_ACC=1
unset SYNOLOGY_LIVE_READ
test -z "$(gofmt -l main.go internal)"
go mod verify
go vet ./...
go test -race -p 2 ./...
go build -o /dev/null .
terraform fmt -check -recursive examples
